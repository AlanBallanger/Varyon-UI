            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label #InfosTabLabel {
                Text: "INFO";
                Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #InfosIcon {
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 6);
            Background: "Icons/Infos.png";
          }
        }
        
        Label { FlexWeight: 1; }
        
        Group #AdminTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          Visible: false;
          
          Button #AdminTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #1e2d3d)),

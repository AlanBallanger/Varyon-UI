$C = "Common.ui";

$C.@PageOverlay {
  
  $C.@DecoratedContainer {
    Anchor: (Width: 1125, Height: 775);
    
    #Title {
      Group {
        LayoutMode: Left;
        
        Label #MenuTitle {
          FlexWeight: 1;
          Text: "VARYON - HOME";
          Style: (FontSize: 23, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
        }
        
        TextButton #CloseButton {
          Text: "X";
          Anchor: (Width: 30, Height: 30, Top: 2, Right: 10);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
          );
        }
      }
    }
    
    #Content {
      LayoutMode: Left;
      
      Group #TabBar {
        LayoutMode: Top;
        Anchor: (Width: 175);
        Background: (Color: #203040);
        Padding: (Top: 8, Bottom: 8, Left: 8, Right: 8);
        
        Group #HomeTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #HomeTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #2a4a6a)),
              Hovered: (Background: (Color: #3a5a7a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "ACCUEIL";
                Style: (FontSize: 14, TextColor: #88ccff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #HomeIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 3);
            Background: "Icons/Accueil.png";
          }
        }
        
        Group #TutorielTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #TutorielTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #1e2d3d)),
              Hovered: (Background: (Color: #2a3a4a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "TUTORIEL";
                Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #TutorielIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 3);
            Background: "Icons/Tutoriel.png";
          }
        }
        
        Group #CommandesTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #CommandesTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #1e2d3d)),
              Hovered: (Background: (Color: #2a3a4a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "COMMANDES";
                Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #CommandesIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 3);
            Background: "Icons/Commandes.png";
          }
        }
        
        Group #MisesAJourTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #MisesAJourTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #1e2d3d)),
              Hovered: (Background: (Color: #2a3a4a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "ACTUALITÉimage.pngS";
                Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #MisesAJourIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 3);
            Background: "Icons/Mises_a_jour.png";
          }
        }
        
        Group #InfosTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #InfosTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #1e2d3d)),
              Hovered: (Background: (Color: #2a3a4a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "INFO";
                Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #InfosIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 3);
            Background: "Icons/Infos.png";
          }
        }
        
        Label { FlexWeight: 1; }
      }
      
      Group #ContentArea {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: (Color: #182230);
        Padding: (Top: 16, Bottom: 16, Left: 16, Right: 16);
        
        Group #HomeContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: true;
          
          Label #HomeTitle {
            Text: "Welcome to Varyon";
            Style: (FontSize: 18, RenderBold: true, TextColor: #aaddff);
            Anchor: (Bottom: 12);
          }
          
          Group #HomeList {
            LayoutMode: Top;
            FlexWeight: 1;
            
            Label {
              Text: "Home Page";
              Style: (FontSize: 16, TextColor: #ffffff);
            }
          }
        }
        
        Group #TutorielContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "Tutorial Page";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #CommandesContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Group #CommandesList {
            LayoutMode: Top;
            FlexWeight: 1;
            
            Label #CategoryTitle1 {
              Text: "CATEGORY 1";
              Style: (FontSize: 20, RenderBold: true, TextColor: #aaddff);
              Anchor: (Bottom: 12);
              Visible: false;
            }
            
            Group #ButtonRow1 {
              LayoutMode: Left;
              Anchor: (Height: 50, Bottom: 12);
              
              Button #CommandButton1 {
                Anchor: (Width: 180, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
                  Hovered: (Background: (Color: #3a5a7a)),
                  Pressed: (Background: (Color: #2a4a6a))
                );
                
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 6, Bottom: 6, Left: 6, Right: 6);
                  
                  Label #CommandButton1Label {
                    Text: "Button 1";
                    Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
                    Anchor: (Bottom: 2);
                  }
                  
                  Label #CommandButton1Cmd {
                    Text: "/command";
                    Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Center);
                  }
                }
              }
              
              Button #CommandButton2 {
                Anchor: (Width: 180, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
                  Hovered: (Background: (Color: #3a5a7a)),
                  Pressed: (Background: (Color: #2a4a6a))
                );
                
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 6, Bottom: 6, Left: 6, Right: 6);
                  
                  Label #CommandButton2Label {
                    Text: "Button 2";
                    Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
                    Anchor: (Bottom: 2);
                  }
                  
                  Label #CommandButton2Cmd {
                    Text: "/command";
                    Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Center);
                  }
                }
              }
              
              Button #CommandButton3 {
                Anchor: (Width: 180, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
                  Hovered: (Background: (Color: #3a5a7a)),
                  Pressed: (Background: (Color: #2a4a6a))
                );
                
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 6, Bottom: 6, Left: 6, Right: 6);
                  
                  Label #CommandButton3Label {
                    Text: "Button 3";
                    Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
                    Anchor: (Bottom: 2);
                  }
                  
                  Label #CommandButton3Cmd {
                    Text: "/command";
                    Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Center);
                  }
                }
              }
              
              Button #CommandButton4 {
                Anchor: (Width: 180, Height: 50);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
                  Hovered: (Background: (Color: #3a5a7a)),
                  Pressed: (Background: (Color: #2a4a6a))
                );
                
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 6, Bottom: 6, Left: 6, Right: 6);
                  
                  Label #CommandButton4Label {
                    Text: "Button 4";
                    Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
                    Anchor: (Bottom: 2);
                  }
                  
                  Label #CommandButton4Cmd {
                    Text: "/command";
                    Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Center);
                  }
                }
              }
            }
            
            Label #CategoryTitle2 {
              Text: "CATEGORY 2";
              Style: (FontSize: 20, RenderBold: true, TextColor: #aaddff);
              Anchor: (Bottom: 12, Top: 12);
              Visible: false;
            }
            
            Group #ButtonRow2 {
              LayoutMode: Left;
              Anchor: (Height: 50, Bottom: 12);
              
              Button #CommandButton5 {
                Anchor: (Width: 180, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
                  Hovered: (Background: (Color: #3a5a7a)),
                  Pressed: (Background: (Color: #2a4a6a))
                );
                
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 6, Bottom: 6, Left: 6, Right: 6);
                  
                  Label #CommandButton5Label {
                    Text: "Button 5";
                    Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
                    Anchor: (Bottom: 2);
                  }
                  
                  Label #CommandButton5Cmd {
                    Text: "/command";
                    Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Center);
                  }
                }
              }
              
              Button #CommandButton6 {
                Anchor: (Width: 180, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
                  Hovered: (Background: (Color: #3a5a7a)),
                  Pressed: (Background: (Color: #2a4a6a))
                );
                
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 6, Bottom: 6, Left: 6, Right: 6);
                  
                  Label #CommandButton6Label {
                    Text: "Button 6";
                    Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
                    Anchor: (Bottom: 2);
                  }
                  
                  Label #CommandButton6Cmd {
                    Text: "/command";
                    Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Center);
                  }
                }
              }
              
              Button #CommandButton7 {
                Anchor: (Width: 180, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
                  Hovered: (Background: (Color: #3a5a7a)),
                  Pressed: (Background: (Color: #2a4a6a))
                );
                
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 6, Bottom: 6, Left: 6, Right: 6);
                  
                  Label #CommandButton7Label {
                    Text: "Button 7";
                    Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
                    Anchor: (Bottom: 2);
                  }
                  
                  Label #CommandButton7Cmd {
                    Text: "/command";
                    Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Center);
                  }
                }
              }
              
              Button #CommandButton8 {
                Anchor: (Width: 180, Height: 50);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
                  Hovered: (Background: (Color: #3a5a7a)),
                  Pressed: (Background: (Color: #2a4a6a))
                );
                
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 6, Bottom: 6, Left: 6, Right: 6);
                  
                  Label #CommandButton8Label {
                    Text: "Button 8";
                    Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
                    Anchor: (Bottom: 2);
                  }
                  
                  Label #CommandButton8Cmd {
                    Text: "/command";
                    Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Center);
                  }
                }
              }
            }
          }
        }
        
        Group #MisesAJourContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "News Page";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #InfosContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "Info Page";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
      }
    }
  }
}

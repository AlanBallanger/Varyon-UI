              }
            }
          }
          
          Group #AdminIcon {
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 6);
            Background: "Icons/Commandes.png";
          }
        }
      }
      
      Group #ContentArea {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: (Color: #182230);
        Padding: (Top: 16, Bottom: 16, Left: 16, Right: 16);
        
        Group #HomeContent {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Visible: true;
          Padding: (Top: 16, Bottom: 16, Left: 16, Right: 16);
          
                    Group #HomeImage {

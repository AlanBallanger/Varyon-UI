$C = "Common.ui";

$C.@PageOverlay {
  
  Group {
    Anchor: (Width: 1125, Height: 775);
    Background: (Color: #151b24);

    Group #Content {
      LayoutMode: Left;

      Group #LeftMenuSidebar {
        Anchor: (Width: 248);
        LayoutMode: Left;
        Background: (Color: #203040);

        Group #LeftMenuSidebarInner {
          Anchor: (Width: 247);

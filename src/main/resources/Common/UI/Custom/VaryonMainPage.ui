$C = "Common.ui";

$C.@PageOverlay {
  
  $C.@DecoratedContainer {
    Anchor: (Width: 1125, Height: 775);
    
    #Title {
      Group {
        LayoutMode: Left;
        
        Label #MenuTitle {
          FlexWeight: 1;
          Text: "VARYON - HOME";
          Style: (FontSize: 23, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
        }
        
        TextButton #CloseButton {
          Text: "X";
          Anchor: (Width: 36, Height: 36, Top: 5, Right: 10);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
          );
        }
      }
    }
    
    #Content {
      LayoutMode: Left;
      
      Group #TabBar {
        LayoutMode: Top;
        Anchor: (Width: 152);
        Background: (Color: #203040);
        Padding: (Top: 8, Bottom: 8, Left: 8, Right: 8);
        
        Group #HomeTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #HomeTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #2a4a6a)),
              Hovered: (Background: (Color: #3a5a7a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "HOME";
                Style: (FontSize: 14, TextColor: #88ccff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #HomeIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 9);
            Background: "Icons/Accueil.png";
          }
        }
        
        Group #TutorielTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #TutorielTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #1e2d3d)),
              Hovered: (Background: (Color: #2a3a4a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "TUTORIAL";
                Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #TutorielIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 9);
            Background: "Icons/Tutoriel.png";
          }
        }
        
        Group #CommandesTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #CommandesTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #1e2d3d)),
              Hovered: (Background: (Color: #2a3a4a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "COMMANDS";
                Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #CommandesIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 9);
            Background: "Icons/Commandes.png";
          }
        }
        
        Group #MisesAJourTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #MisesAJourTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #1e2d3d)),
              Hovered: (Background: (Color: #2a3a4a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "NEWS";
                Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #MisesAJourIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 9);
            Background: "Icons/Mises_a_jour.png";
          }
        }
        
        Group #InfosTabContainer {
          Anchor: (Height: 50, Bottom: 6);
          
          Button #InfosTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 6);
            Style: ButtonStyle(
              Default: (Background: (Color: #1e2d3d)),
              Hovered: (Background: (Color: #2a3a4a)),
              Pressed: (Background: (Color: #2a4a6a))
            );
            OutlineColor: #1a2a3a;
            OutlineSize: 3;
            
            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Label {
                Text: "INFO";
                Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }
          }
          
          Group #InfosIcon {
            LayoutMode: Middle;
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 9);
            Background: "Icons/Infos.png";
          }
        }
        
        Label { FlexWeight: 1; }
      }
      
      Group #ContentArea {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: (Color: #182230);
        Padding: (Top: 16, Bottom: 16, Left: 16, Right: 16);
        
        Group #HomeContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: true;
          
          Label #HomeTitle {
            Text: "Welcome to Varyon";
            Style: (FontSize: 18, RenderBold: true, TextColor: #aaddff);
            Anchor: (Bottom: 12);
          }
          
          Group #HomeList {
            LayoutMode: Top;
            FlexWeight: 1;
            
            Label {
              Text: "Home Page";
              Style: (FontSize: 16, TextColor: #ffffff);
            }
          }
        }
        
        Group #TutorielContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "Tutorial Page";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #CommandesContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Group #CommandesList {
            LayoutMode: Top;
            FlexWeight: 1;
            
            Label #CategoryTitle1 {
              Text: "CATEGORY 1";
              Style: (FontSize: 16, RenderBold: true, TextColor: #aaddff);
              Anchor: (Bottom: 12);
              Visible: false;
            }
            
            Group #ButtonRow1 {
              LayoutMode: Left;
              Anchor: (Height: 50, Bottom: 12);
              
              TextButton #CommandButton1 {
                Text: "Button 1";
                Anchor: (Width: 250, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: TextButtonStyle(
                  Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (Color: #3a5a7a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
                );
              }
              
              TextButton #CommandButton2 {
                Text: "Button 2";
                Anchor: (Width: 250, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: TextButtonStyle(
                  Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (Color: #3a5a7a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
                );
              }
              
              TextButton #CommandButton3 {
                Text: "Button 3";
                Anchor: (Width: 250, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: TextButtonStyle(
                  Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (Color: #3a5a7a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
                );
              }
              
              TextButton #CommandButton4 {
                Text: "Button 4";
                Anchor: (Width: 250, Height: 50);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: TextButtonStyle(
                  Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (Color: #3a5a7a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
                );
              }
            }
            
            Label #CategoryTitle2 {
              Text: "CATEGORY 2";
              Style: (FontSize: 16, RenderBold: true, TextColor: #aaddff);
              Anchor: (Bottom: 12, Top: 12);
              Visible: false;
            }
            
            Group #ButtonRow2 {
              LayoutMode: Left;
              Anchor: (Height: 50, Bottom: 12);
              
              TextButton #CommandButton5 {
                Text: "Button 5";
                Anchor: (Width: 250, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: TextButtonStyle(
                  Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (Color: #3a5a7a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
                );
              }
              
              TextButton #CommandButton6 {
                Text: "Button 6";
                Anchor: (Width: 250, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: TextButtonStyle(
                  Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (Color: #3a5a7a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
                );
              }
              
              TextButton #CommandButton7 {
                Text: "Button 7";
                Anchor: (Width: 250, Height: 50, Right: 2);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: TextButtonStyle(
                  Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (Color: #3a5a7a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
                );
              }
              
              TextButton #CommandButton8 {
                Text: "Button 8";
                Anchor: (Width: 250, Height: 50);
                Background: (Color: #2a4a6a);
                Visible: false;
                Style: TextButtonStyle(
                  Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (Color: #3a5a7a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
                );
              }
            }
          }
        }
        
        Group #MisesAJourContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "News Page";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #InfosContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "Info Page";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
      }
    }
  }
}

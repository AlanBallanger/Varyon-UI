                Anchor: (Height: 40, Bottom: 12);
              }

              Group #PtClaimAllRow {
                LayoutMode: Middle;
                Anchor: (Height: 40);

                TextButton #PtClaimAllBtn {
                  Text: "";
                  Anchor: (Width: 220, Height: 36);
                  Style: $C.@SmallSecondaryTextButtonStyle;
                }
              }
            }
            }
          }
        
          Group #AdminContent {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Visible: false;
          
            Group #AdminCommandesList {
              LayoutMode: Top;
            }
          }
        }
      }
    }

    TextButton #CloseButton {
      Text: "X";
      Anchor: (Width: 30, Height: 30, Top: 8, Right: 12);
      Style: TextButtonStyle(
        Default: (LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center)),
        Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center))
      );
    }
  }
}

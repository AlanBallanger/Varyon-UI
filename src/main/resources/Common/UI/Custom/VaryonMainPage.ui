$C = "Common.ui";

$C.@PageOverlay {
  
  Group {
    Anchor: (Width: 1125, Height: 775);
    Background: (Color: #151b24);

    Group #Content {
      LayoutMode: Left;
      
      Group #TabBar {
        LayoutMode: Top;
        Anchor: (Width: 175);
        Background: (Color: #203040);
        Padding: (Top: 0, Bottom: 0, Left: 0, Right: 0);
        
        Group #HomeTabContainer {
          Anchor: (Height: 50);
          
          Button #HomeTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 1);
            Style: ButtonStyle(
              Default: (Background: (Color: #203040)),
              Hovered: (Background: (Color: #2a3545)),
              Pressed: (Background: (Color: #2a3545))
            );

            Group {
              LayoutMode: Middle;
              Padding: (Left: 40, Right: 8);
              
              Group {
                LayoutMode: Top;
                
                Label #HomeTabLabel {
                  Text: "ACCUEIL";
                  Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
                }
                
                Label #HomeTabShortcut {
                  Text: "/acc, /accueil";
                  Style: (FontSize: 10, TextColor: #778899, HorizontalAlignment: Center);
                  Visible: false;
                }
              }
            }
          }
          
          Group #HomeIcon {
            Anchor: (Width: 32, Height: 32, Left: 8, Top: 9);
            Background: "Icons/Accueil.png";
          }

          Group {
            Anchor: (Height: 1, Left: 0, Right: 0, Bottom: 0);
            Background: (Color: #151b24);
          }
        }
        
        Group #TutorielTabContainer {
          Anchor: (Height: 50);
          

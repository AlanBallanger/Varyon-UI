            }

          Group {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0);

          Group #LeftMenuSidebarXpSection {
            FlexWeight: 1;
            Anchor: (Left: 0, Right: 0);
            LayoutMode: Top;
            Padding: (Top: 10, Left: 5, Right: 0);

            Group #MenuGenXPPanel {
              LayoutMode: Top;
              Anchor: (Left: 0, Right: 0);
              Padding: (Bottom: 8);

              Group {
                LayoutMode: Left;
                Anchor: (Height: 18);

                Group #MenuGenLevelBg {
                  Anchor: (Width: 52, Height: 18);
                  Padding: (Left: 6, Right: 6, Top: 2, Bottom: 2);
                  Background: PatchStyle(Color: #2a1a00e0);
                  LayoutMode: Middle;
                  Label #MenuGenLevel {
                    Text: "";
                    Style: (FontSize: 11, TextColor: #FFD866, RenderBold: true, VerticalAlignment: Center);
                  }
                }

                Label #MenuGenLevelLabel {
                  Text: "";
                  Anchor: (Height: 18);
                  FlexWeight: 1;
                  Style: (FontSize: 11, TextColor: #b8c8d8, VerticalAlignment: Center);
                }

                Label #MenuGenXPText {
                  Text: "";
                  Anchor: (Height: 18);
                  Style: (FontSize: 10, TextColor: #8899aa, VerticalAlignment: Center);
                }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 12, Left: 0, Right: 0);

                Group #MenuGenXPTrack {
                  FlexWeight: 1;
                  Anchor: (Height: 12);
                  Background: PatchStyle(TexturePath: "Common/ProgressBarEmpty.png", Border: 4);
                  ProgressBar #MenuGenXP {
                    Anchor: (Top: 1, Left: 2, Right: 2, Bottom: 1);
                    Value: 0.0;
                    BarTexturePath: "Common/ProgressBarFill.png";
                  }
                }

                Group { Anchor: (Width: 4); }

                Button #MenuGenDetailBtn {
                  Anchor: (Width: 54, Height: 14);
                  Style: ButtonStyle(
                    Default: (Background: (Color: #2a3545)),
                    Hovered: (Background: (Color: #4a6ea8)),
                    Pressed: (Background: (Color: #2a3545))
                  );
                  Group {
                    LayoutMode: Middle;
                    Label { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                      Text: "Détails";
                      Style: (FontSize: 11, TextColor: #dceeff, VerticalAlignment: Center, HorizontalAlignment: Center);
                    }
                  }
                }
              }
            }

            Group #MenuJob1Panel {
              LayoutMode: Top;
              Anchor: (Left: 0, Right: 0);
              Padding: (Bottom: 6);

              Group {
                LayoutMode: Left;
                Anchor: (Height: 18);

                Group #MenuJob1LevelBg {

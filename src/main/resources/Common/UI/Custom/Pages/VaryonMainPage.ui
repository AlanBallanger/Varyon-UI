// Interface principale Varyon
Group {
  LayoutMode: Middle;
  Background: (Color: #00000099);
  
  Group {
    LayoutMode: Top;
    Anchor: (Width: 1125, Height: 775);
    Background: (Color: #182230);
    OutlineColor: #405060;
    OutlineSize: 2;
    
    // En-t?te
    Group {
      LayoutMode: Left;
      Anchor: (Height: 46);
      Background: (Color: #203040);
      OutlineSize: 1;

      Label #MenuTitle {
        FlexWeight: 1;
        Text: "VARYON - ACCUEIL";
        Style: (FontSize: 23, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
      }
      
      TextButton #CloseButton {
        Text: "X";
        Anchor: (Width: 36, Height: 36, Top: 5, Right: 10);
        Background: (Color: #cc4444);
        OutlineColor: #aa2222;
        OutlineSize: 1;
        Style: TextButtonStyle(
          Default: (LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Hovered: (Background: (Color: #dd5555), LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
        );
      }
    }
    
    // Contenu principal
    Group {
      FlexWeight: 1;
      LayoutMode: Left;
      
      // Barre d'onglets verticale ? gauche
      Group #TabBar {
        LayoutMode: Top;
        Anchor: (Width: 168);
        Background: (Color: #203040);
        Padding: (Top: 8, Bottom: 8, Left: 8, Right: 8);
        
        Group #HomeTabContainer {
          Anchor: (Height: 44, Bottom: 4);
          
          TextButton #HomeTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 4);
            Text: "ACCUEIL";
            Background: (Color: #1e2d3d);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Top: 0, Bottom: 0, Left: 40, Right: 8);
            Disabled: true;
            Style: TextButtonStyle(
              Default: (LabelStyle: (FontSize: 13, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Hovered: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Disabled: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 13, TextColor: #88ccff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
            );
          }
          
          Group #HomeIcon {
            LayoutMode: Middle;
            Anchor: (Width: 28, Height: 28, Left: 6, Top: 6);
            Background: "../Icons/Accueil.png";
          }
        }
        
        Group #TutorielTabContainer {
          Anchor: (Height: 44, Bottom: 4);
          
          TextButton #TutorielTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 4);
            Text: "TUTORIEL";
            Background: (Color: #1e2d3d);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Top: 0, Bottom: 0, Left: 40, Right: 8);
            Style: TextButtonStyle(
              Default: (LabelStyle: (FontSize: 13, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Hovered: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Disabled: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 13, TextColor: #88ccff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
            );
          }
          
          Group #TutorielIcon {
            LayoutMode: Middle;
            Anchor: (Width: 28, Height: 28, Left: 6, Top: 6);
            Background: "../Icons/Tutoriel.png";
          }
        }
        
        Group #CommandesTabContainer {
          Anchor: (Height: 44, Bottom: 4);
          
          TextButton #CommandesTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 4);
            Text: "COMMANDES";
            Background: (Color: #1e2d3d);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Top: 0, Bottom: 0, Left: 40, Right: 8);
            Style: TextButtonStyle(
              Default: (LabelStyle: (FontSize: 13, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Hovered: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Disabled: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 13, TextColor: #88ccff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
            );
          }
          
          Group #CommandesIcon {
            LayoutMode: Middle;
            Anchor: (Width: 28, Height: 28, Left: 6, Top: 6);
            Background: "../Icons/Commandes.png";
          }
        }
        
        Group #MisesAJourTabContainer {
          Anchor: (Height: 44, Bottom: 4);
          
          TextButton #MisesAJourTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 4);
            Text: "ACTUALITÉS";
            Background: (Color: #1e2d3d);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Top: 0, Bottom: 0, Left: 40, Right: 8);
            Style: TextButtonStyle(
              Default: (LabelStyle: (FontSize: 13, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Hovered: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Disabled: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 13, TextColor: #88ccff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
            );
          }
          
          Group #MisesAJourIcon {
            LayoutMode: Middle;
            Anchor: (Width: 28, Height: 28, Left: 6, Top: 6);
            Background: "../Icons/Mises_a_jour.png";
          }
        }
        
        Group #InfosTabContainer {
          Anchor: (Height: 44, Bottom: 4);
          
          TextButton #InfosTab {
            Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 4);
            Text: "INFOS";
            Background: (Color: #1e2d3d);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Top: 0, Bottom: 0, Left: 40, Right: 8);
            Style: TextButtonStyle(
              Default: (LabelStyle: (FontSize: 13, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Hovered: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
              Disabled: (Background: (Color: #2a4a6a), LabelStyle: (FontSize: 13, TextColor: #88ccff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
            );
          }
          
          Group #InfosIcon {
            LayoutMode: Middle;
            Anchor: (Width: 28, Height: 28, Left: 6, Top: 6);
            Background: "../Icons/Infos.png";
          }
        }
        
        Label { FlexWeight: 1; }
      }
      
      // Zone de contenu ? droite
      Group #ContentArea {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: (Color: #182230);
        Padding: (Top: 16, Bottom: 16, Left: 16, Right: 16);
        
        // Contenu Accueil
        Group #HomeContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: true;
          
          Label #HomeTitle {
            Text: "Bienvenue sur Varyon";
            Style: (FontSize: 18, RenderBold: true, TextColor: #aaddff);
            Anchor: (Bottom: 12);
          }
          
          Group #HomeList {
            LayoutMode: Top;
            FlexWeight: 1;
          }
        }
        
        // Autres contenus (masqu?s)
        Group #TutorielContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "Page General";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #CommandesContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "Page Infos";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #MisesAJourContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "Page Profil";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #InfosContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: false;
          
          Label {
            Text: "Page Parametres";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
      }
    }
  }
}

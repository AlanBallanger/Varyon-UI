// Interface principale Varyon
Group {
  LayoutMode: Middle;
  Background: (Color: #00000099);
  
  Group {
    LayoutMode: Top;
    Anchor: (Width: 900, Height: 620);
    Background: (Color: #182230);
    OutlineColor: #405060;
    OutlineSize: 2;
    
    // En-tÃªte
    Group {
      LayoutMode: Middle;
      Anchor: (Height: 60, Bottom: 8);
      Background: (Color: #203040);
      
      Label #MenuTitle {
        Text: "VARYON MENU";
        Style: (FontSize: 24, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center);
      }
      
      TextButton #CloseButton {
        Text: "X";
        Anchor: (Width: 40, Height: 40, Right: 10, Vertical: 0);
        Background: (Color: #cc4444);
        OutlineColor: #aa2222;
        OutlineSize: 1;
      }
    }
    
    // Contenu principal
    Group {
      FlexWeight: 1;
      LayoutMode: Left;
      
      // Barre d'onglets Ã  gauche
      Group {
        LayoutMode: Top;
        Anchor: (Width: 150);
        Background: (Color: #203040);
        Padding: (Top: 8, Bottom: 8, Left: 8, Right: 8);
        
        TextButton #HomeTab {
          Text: "ACCUEIL";
          Anchor: (Height: 40, Bottom: 4);
          Background: (Color: #304050);
          OutlineColor: #405060;
          OutlineSize: 1;
          Padding: (Top: 0, Bottom: 0, Left: 12, Right: 0);
        }
        
        TextButton #GeneralTab {
          Text: "GENERAL";
          Anchor: (Height: 40, Bottom: 4);
          Background: (Color: #304050);
          OutlineColor: #405060;
          OutlineSize: 1;
          Padding: (Top: 0, Bottom: 0, Left: 12, Right: 0);
        }
        
        TextButton #InfosTab {
          Text: "INFOS";
          Anchor: (Height: 40, Bottom: 4);
          Background: (Color: #304050);
          OutlineColor: #405060;
          OutlineSize: 1;
          Padding: (Top: 0, Bottom: 0, Left: 12, Right: 0);
        }
        
        TextButton #ProfilTab {
          Text: "PROFIL";
          Anchor: (Height: 40, Bottom: 4);
          Background: (Color: #304050);
          OutlineColor: #405060;
          OutlineSize: 1;
          Padding: (Top: 0, Bottom: 0, Left: 12, Right: 0);
        }
        
        TextButton #SettingsTab {
          Text: "PARAMETRES";
          Anchor: (Height: 40, Bottom: 4);
          Background: (Color: #304050);
          OutlineColor: #405060;
          OutlineSize: 1;
          Padding: (Top: 0, Bottom: 0, Left: 12, Right: 0);
        }
        
        Label { FlexWeight: 1; }
      }
      
      // Zone de contenu
      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: (Color: #182230);
        Padding: (Top: 16, Bottom: 16, Left: 16, Right: 16);
        
        // Contenu Accueil
        Group #HomeContent {
          FlexWeight: 1;
          LayoutMode: Top;
          Visible: true;
          
          Label #HomeTitle {
            Text: "Bienvenue sur Varyon";
            Style: (FontSize: 18, RenderBold: true, TextColor: #aaddff);
            Anchor: (Bottom: 12);
          }
          
          Group #HomeList {
            LayoutMode: Top;
            FlexWeight: 1;
          }
        }
        
        // Autres contenus (masquÃ©s)
        Group #GeneralContent {
          FlexWeight: 1;
          Visible: false;
          
          Label {
            Text: "Page General";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #InfosContent {
          FlexWeight: 1;
          Visible: false;
          
          Label {
            Text: "Page Infos";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #ProfilContent {
          FlexWeight: 1;
          Visible: false;
          
          Label {
            Text: "Page Profil";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
        
        Group #SettingsContent {
          FlexWeight: 1;
          Visible: false;
          
          Label {
            Text: "Page Parametres";
            Style: (FontSize: 16, TextColor: #ffffff);
          }
        }
      }
    }
  }
}